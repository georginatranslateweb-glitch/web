# SMTP (professional provider: SendGrid, Mailgun, Amazon SES, Zoho, etc.)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=quotes@yourdomain.com
EMAIL_PASS=your-smtp-password-or-api-key

# Recipient for new quote requests
EMAIL_TO=quotes@yourdomain.com

# Optional sender display (defaults to EMAIL_USER)
EMAIL_FROM="NAATI Translations" <quotes@yourdomain.com>

# Brand name used in email templates
BRAND_NAME=NAATI Professional Translation
